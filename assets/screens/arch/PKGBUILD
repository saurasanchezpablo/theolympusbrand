  install -Dm644 "$srcdir/boot__plymouth__the-olympus__background.png" "$d/boot/plymouth/the-olympus/background.png"
  install -Dm644 "$srcdir/boot__plymouth__the-olympus__crest.png" "$d/boot/plymouth/the-olympus/crest.png"
  install -Dm644 "$srcdir/boot__plymouth__the-olympus__fill.png" "$d/boot/plymouth/the-olympus/fill.png"
  install -Dm644 "$srcdir/boot__plymouth__the-olympus__the-olympus.plymouth" "$d/boot/plymouth/the-olympus/the-olympus.plymouth"
  install -Dm644 "$srcdir/boot__plymouth__the-olympus__the-olympus.script" "$d/boot/plymouth/the-olympus/the-olympus.script"
  install -Dm644 "$srcdir/boot__plymouth__the-olympus__track.png" "$d/boot/plymouth/the-olympus/track.png"
  install -Dm755 "$srcdir/install.sh" "$d/install.sh"
  install -Dm755 "$srcdir/shell__alacritty__install.sh" "$d/shell/alacritty/install.sh"
  install -Dm644 "$srcdir/shell__alacritty__the-olympus.toml" "$d/shell/alacritty/the-olympus.toml"
