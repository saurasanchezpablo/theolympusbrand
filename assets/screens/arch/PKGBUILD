# Each build is newer than the last: the site's files may have changed.
pkgver() {
  date -u +%Y%m%d.%H%M
}

package() {
  local d="$pkgdir/usr/share/the-olympus/screens"
  install -Dm755 "$srcdir/the-olympus" "$pkgdir/usr/bin/the-olympus"
  install -Dm755 "$srcdir/the-olympus-terminal" "$pkgdir/usr/bin/the-olympus-terminal"
  install -Dm644 "$srcdir/boot__grub__background.png" "$d/boot/grub/background.png"
  install -Dm755 "$srcdir/boot__grub__install.sh" "$d/boot/grub/install.sh"
  install -Dm755 "$srcdir/boot__limine__install.sh" "$d/boot/limine/install.sh"
  install -Dm644 "$srcdir/boot__limine__wallpaper.png" "$d/boot/limine/wallpaper.png"
