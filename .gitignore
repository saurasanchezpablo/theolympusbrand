node_modules/
dist/
.DS_Store
*.log

# Design explorations are kept locally; their boards live in docs/creative-directions/.
explorations/
# Printable models are generated on demand (npm run model, or the Atelier);
# only the master's are kept.
manufacturing/3d/*
!manufacturing/3d/master/
# The lithophane mesh is heavy (≈ 15 MB) and rebuilds in seconds.
manufacturing/3d/master/lithophane/
# Stickers are generated on demand (npm run sticker, or the Atelier); the
# master's and the catalogue sheets are kept.
manufacturing/stickers/*
!manufacturing/stickers/master/
!manufacturing/stickers/sheets/
# A service's screens are generated on demand (npm run screens -- <id>); the master's are kept.
assets/screens/services/
