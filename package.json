{
  "name": "theolympusbrand",
  "version": "0.1.0",
  "private": true,
  "description": "The Olympus — visual identity system for a private server ecosystem",
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test tests/geometry.test.ts",
    "typecheck": "tsc -p .",
    "build:master": "node scripts/build-master.ts",
    "build:docs": "node scripts/build-docs.ts",
    "build": "npm run build:master && npm run build:docs"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "24.19.2",
    "@types/opentype.js": "1.3.10",
    "clipper-lib": "6.4.2",
    "opentype.js": "1.3.4",
    "polygon-clipping": "0.15.7",
    "typescript": "5.9.3"
  }
}
