{
  "name": "theolympusbrand",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "The Olympus — visual identity system for a private server ecosystem",
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test tests/geometry.test.ts",
    "typecheck": "tsc -p . && tsc -p app",
    "build:master": "node scripts/build-master.ts",
    "build:docs": "node scripts/build-docs.ts",
    "service": "node scripts/service.ts",
    "build:services": "node scripts/service.ts build",
    "build": "npm run build:master && npm run build:services && npm run build:docs && npm run brandbook && npm run integrations && npm run screens && npm run installer && npm run map",
    "app": "node scripts/map.ts && vite --config app/vite.config.ts",
    "app:build": "node scripts/map.ts && vite build --config app/vite.config.ts",
    "app:preview": "vite preview --config app/vite.config.ts",
    "app:check": "node scripts/app-check.ts",
    "model": "node scripts/model.ts",
    "sticker": "node scripts/sticker.ts",
    "site": "node scripts/map.ts && vite build --config app/vite.config.ts",
    "integrations": "node scripts/integrations.ts",
    "brandbook": "node scripts/brandbook.ts",
    "screens": "node scripts/screens.ts",
    "app:viewports": "node scripts/viewport-check.ts",
    "autobuild": "node scripts/autobuild.ts",
    "installer": "node scripts/installer.ts",
    "map": "node scripts/map.ts",
    "editor": "node scripts/editor.ts"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rive-app/canvas": "2.44.0",
    "@rive-app/react-canvas": "4.36.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.10.3",
    "class-variance-authority": "0.7.1",
    "clipper-lib": "6.4.2",
    "cn": "0.4.0",
    "earcut": "3.2.4",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "gsap": "3.15.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.52.0",
    "marked": "18.1.1",
    "motion": "14.0.0",
    "opentype.js": "1.3.4",
    "playwright-core": "1.64.1",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgpath": "2.6.0",
    "swiper": "14.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "yaml": "2.9.1"
  }
}
